{
  "name": "Wan 2.2 Image-to-Video (5B TI2V)",
  "description": "Image-to-video using the Wan 2.2 TI2V 5B model (base tier). Animates a reference image with a motion prompt. 720p, 24fps.",
  "tier": "base",
  "mode": "i2v",
  "meta": {
    "params": {
      "positive_prompt": [["5", "text"]],
      "negative_prompt": [["6", "text"]],
      "input_image": [["12", "image"]],
      "width": [["7", "width"]],
      "height": [["7", "height"]],
      "length": [["7", "length"]],
      "seed": [["8", "seed"]],
      "steps": [["8", "steps"]],
      "cfg": [["8", "cfg"]],
      "fps": [["10", "fps"]],
      "filename_prefix": [["11", "filename_prefix"]]
    },
    "defaults": {
      "width": 1280,
      "height": 704,
      "length": 121,
      "seed": 0,
      "steps": 20,
      "cfg": 5.0,
      "fps": 24,
      "input_image": "example.png",
      "filename_prefix": "AI-Video-Studio/i2v"
    }
  },
  "prompt": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "wan2.2_ti2v_5B_fp16.safetensors",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
        "type": "wan",
        "device": "default"
      }
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "wan2.2_vae.safetensors"
      }
    },
    "4": {
      "class_type": "ModelSamplingSD3",
      "inputs": {
        "model": ["1", 0],
        "shift": 8.0
      }
    },
    "5": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "The subject comes to life with gentle, natural motion. Slow cinematic camera push-in, soft realistic lighting, smooth temporal consistency.",
        "clip": ["2", 0]
      }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "blurry, low quality, distorted, static, overexposed, watermark, text, extra limbs, deformed, flickering",
        "clip": ["2", 0]
      }
    },
    "12": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "example.png"
      }
    },
    "7": {
      "class_type": "Wan22ImageToVideoLatent",
      "inputs": {
        "vae": ["3", 0],
        "width": 1280,
        "height": 704,
        "length": 121,
        "batch_size": 1,
        "start_image": ["12", 0]
      }
    },
    "8": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["4", 0],
        "positive": ["5", 0],
        "negative": ["6", 0],
        "latent_image": ["7", 0],
        "seed": 0,
        "steps": 20,
        "cfg": 5.0,
        "sampler_name": "uni_pc",
        "scheduler": "simple",
        "denoise": 1.0
      }
    },
    "9": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["8", 0],
        "vae": ["3", 0]
      }
    },
    "10": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": ["9", 0],
        "fps": 24
      }
    },
    "11": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": ["10", 0],
        "filename_prefix": "AI-Video-Studio/i2v",
        "format": "auto",
        "codec": "auto"
      }
    }
  }
}
