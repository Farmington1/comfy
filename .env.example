# ======================================================================
# AI Video Studio - example environment file
# Copy to `.env` and fill in as needed. NEVER commit your real `.env`.
# All values are OPTIONAL - the project works with sensible defaults.
# ======================================================================

# --- Repository (used by the notebook to clone itself in Colab) ---------
# Colab's "Open in Colab" loader only works with PUBLIC github.com repos.
# If you mirror this repo to github.com, set the clone URL here.
AVS_REPO_URL=https://github.com/Farmington1/comfy.git
AVS_REPO_BRANCH=main

# --- Hugging Face -------------------------------------------------------
# Only required for GATED models. The default Wan 2.2 models used by this
# project are public and need NO token. Leave blank unless a download 403s.
HF_TOKEN=

# --- Google Drive -------------------------------------------------------
# Mount point used inside Colab (default is fine).
AVS_DRIVE_MOUNT=/content/drive
# Root folder created inside your Drive for persistence.
AVS_DRIVE_ROOT=AI-Video-Studio
# Set to 0 to disable Google Drive persistence entirely (ephemeral runs).
AVS_USE_DRIVE=1

# --- Model tier to download by default ----------------------------------
# base    -> Wan 2.2 TI2V 5B (powers t2v, i2v, fast_preview)  [~17 GB]
# quality -> adds Wan 2.2 14B T2V high/low noise (high_quality) [~35 GB]
# gguf    -> low-VRAM quantized variants
AVS_MODEL_TIER=base

# --- ComfyUI server (local to the Colab VM) -----------------------------
AVS_COMFY_HOST=127.0.0.1
AVS_COMFY_PORT=8188
